            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GGX alpha van de glans; None = standaard per soort",
          "title": "Roughness"
        },
        "type": {
          "const": "paint",
          "default": "paint",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Paint",
      "type": "object"
    },
    "PaintStack": {
      "additionalProperties": false,
      "description": "T24: gestapelde verflagen op een vlak, van binnen (tegen de epoxy) naar buiten (naar de lucht).\n\nElke laag is een `Paint` met een eigen `dekking`. Een doorschijnende laag laat de laag eronder zichtbaar;\nhet effectieve beeld volgt uit Kubelka-Munk (`carbonne.core.lagen`). Een stapel van een ondoorzichtige laag\nis bit-identiek aan die `Paint` zelf.",
      "properties": {
        "lagen": {
          "description": "van binnen (epoxy) naar buiten (lucht)",
          "items": {
            "$ref": "#/$defs/Paint"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Lagen",
          "type": "array"
        },
        "type": {
          "const": "paintstack",
          "default": "paintstack",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lagen"
      ],
      "title": "PaintStack",
      "type": "object"
    },
